# Rendered at container start by nginx's envsubst entrypoint, which
# substitutes only names present in the environment — nginx's own
# $uri, $host and $http_upgrade are left alone.

server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://gold-tracker-api:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # The Authorization header is NOT injected here. Doing so made
        # reaching this port equivalent to holding the token, which left
        # the site open to anyone who loaded it. The browser now sends a
        # session token earned at /api/login instead.
        proxy_set_header Authorization $http_authorization;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
