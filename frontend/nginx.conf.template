# Rendered at container start by nginx's envsubst entrypoint, which
# substitutes only names present in the environment — nginx's own
# $uri, $host and $http_upgrade are left alone.

server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://gold-tracker-api:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # The API requires a bearer token on every route but /api/health.
        # It is attached here rather than in the app bundle: a secret
        # shipped to the browser is a secret given to anyone who opens
        # the page. The consequence is that reaching this port is the
        # same as holding the token, so keep the UI behind whatever
        # authentication fronts it.
        proxy_set_header Authorization "Bearer ${GOLD_API_TOKEN}";
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
