# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real credentials.

GOLD_DB_PASS=YourStrongApplicationPasswordHere

# --- API access (required) ---
# Shared secret for every API route except /api/health. The API refuses
# all requests until this is set: an open instance lets anyone read the
# portfolio, delete it, or spend Claude subscription quota.
#
# Generate one with:
#   openssl rand -base64 32
#
# The UI container needs the same value. nginx attaches it to the
# requests it proxies, so it never reaches the browser — which also
# means anyone who can reach the UI has the API's full access. Keep the
# UI behind whatever authentication fronts it.
GOLD_API_TOKEN=

# Only needed when something other than the bundled UI calls the API
# from a browser — a separate dashboard on another host, for instance.
# Left empty, no CORS header is sent and only same-origin requests work.
GOLD_ALLOWED_ORIGIN=

# --- AI signal generation (optional) ---
# The app runs normally with all of these unset; the Analyze button
# simply reports that AI is not configured.

# The only switch that turns the feature on.
AI_ENABLED=false

# Required in Docker, where there is no logged-in CLI session. Generate
# one with `claude setup-token`.
#
# Leave this EMPTY when running the API directly on a machine where the
# claude CLI is already logged in — a placeholder value overrides that
# working session auth and every run fails with "401 Invalid bearer
# token".
CLAUDE_CODE_OAUTH_TOKEN=

AI_MODEL=claude-opus-5

# How long a single generation may take before it is abandoned.
# Real runs against ~90 price rows land around 20 seconds.
AI_TIMEOUT_SECONDS=180

# Minimum hours between automatic signals. Automatic generation is
# triggered by a new price arriving, and the subscription's rate limit
# is shared with your own interactive Claude Code use.
AI_AUTO_MIN_HOURS=24

# Minimum seconds between on-demand generations. The API has no
# authentication, so this bounds how fast anything reaching it can
# spend subscription quota.
AI_MANUAL_COOLDOWN_SECONDS=60
